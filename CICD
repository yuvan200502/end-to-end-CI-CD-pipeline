pipeline {

    agent any

    tools {
        jdk 'jdk11'
        maven 'maven3'
    }

    stages {

        stage('GIT CHECKOUT') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/yuvan200502/end-to-end-CI-CD-pipeline.git'
            }
        }

        stage('MAVEN BUILD') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('TRIVY FILESYSTEM SCAN') {
            steps {
                sh '''
                    trivy fs \
                    --format table \
                    -o trivy-fs-report.html \
                    .
                '''
            }
        }

        stage('SONARQUBE ANALYSIS') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                        -Dsonar.projectName=database_service_project \
                        -Dsonar.projectKey=database_service_project \
                        -Dsonar.java.binaries=target/classes
                    '''
                }
            }
        }

        stage('DOCKER BUILD') {
            steps {
                sh '''
                    docker build -t database-service:${BUILD_NUMBER} .
                    docker tag database-service:${BUILD_NUMBER} database-service:latest
                '''
            }
        }

        stage('TRIVY IMAGE SCAN') {
            steps {
                sh '''
                    mkdir -p /opt/trivy-tmp
                    TMPDIR=/opt/trivy-tmp trivy image database-service:${BUILD_NUMBER}
                '''
            }
        }

        stage('DOCKER HUB LOGIN') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" \
                        --password-stdin
                    '''
                }
            }
        }

        stage('DOCKER HUB PUSH') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USERNAME',
                    passwordVariable: 'DOCKER_PASSWORD'
                )]) {
                    sh '''
                        docker tag database-service:${BUILD_NUMBER} \
                        ${DOCKER_USERNAME}/database-service:${BUILD_NUMBER}

                        docker tag database-service:${BUILD_NUMBER} \
                        ${DOCKER_USERNAME}/database-service:latest

                        docker push ${DOCKER_USERNAME}/database-service:${BUILD_NUMBER}
                        docker push ${DOCKER_USERNAME}/database-service:latest
                    '''
                }
            }
        }

        stage('AWS EC2 CONTAINER RUN') {
            steps {
                sshagent(['aws-ec2-key']) {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh '''
                            ssh -o StrictHostKeyChecking=no ubuntu@16.171.67.110 << EOF

                            echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                            docker pull $DOCKER_USERNAME/database-service:latest

                            docker stop database-service || true
                            docker rm database-service || true

                            docker run -d \
                                -p 8082:8080 \
                                --name database-service \
                                $DOCKER_USERNAME/database-service:latest

                            docker ps

                            EOF
                        '''
                    }
                }
            }
        }
    }
}

